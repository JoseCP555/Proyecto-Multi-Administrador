# --- Base de datos ---------------------------------------------------------
# PostgreSQL del contenedor (publicado en 5433):
DATABASE_URL=postgresql://multiadmin:multiadmin@localhost:5433/multiadmin_db
# PostgreSQL local:
# DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/multiadmin_db
# Sin PostgreSQL (la API usa SQLite automáticamente):
# DATABASE_URL=

# Clave secreta para firmar los JWT
SECRET_KEY=cambia-esto-por-un-valor-secreto-largo-y-aleatorio

# CORS: origenes permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# URL del frontend (para el enlace de recuperación de contraseña)
FRONTEND_URL=http://localhost:3000

# Logging SQL
SQL_ECHO=false

# -------- SMTP (correo real: verificación de cuenta y recuperación de contraseña) --------
# Gmail: activa la verificación en dos pasos y crea una "Contraseña de aplicación"
# (https://myaccount.google.com/apppasswords). Son 16 letras; se pega SIN espacios.
# OBLIGATORIO para registro con verificación y recuperación de contraseña (sin esto NO se envían correos).
EMAIL_USER=
EMAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# -------- Registro de administradores (modo demo) --------
# true = el formulario "Crear cuenta" puede elegir Administrador.
# false = bloqueado (recomendado en producción).
PERMITIR_REGISTRO_ADMIN=true

# -------- Redis --------
REDIS_URL=redis://localhost:6379/0

# -------- Chatbot --------
# Si se deja vacío, el chatbot usa el motor local (base de datos + reglas).
# Si se llena con una API de OpenAI, el chatbot usa LLM + RAG.
CHATBOT_ENGINE=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Notificaciones reales: Web Push (VAPID) ---
# Genera tus propias claves con:  python backend/generar_vapid.py --guardar
# La PRIVADA va SOLO en .env (gitignored). Aquí deja los marcadores.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@gmail.com
# Interruptor de emergencia para los correos de notificaciones (true/false).
NOTIFICACIONES_CORREO=true
