# --- Base de datos ---------------------------------------------------------
# PostgreSQL del contenedor (publicado en 5433):
DATABASE_URL=postgresql://multiadmin:multiadmin@localhost:5433/multiadmin_db
# PostgreSQL local:
# DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/multiadmin_db
# Sin PostgreSQL (la API usa SQLite automáticamente):
# DATABASE_URL=

# Clave secreta para firmar los JWT
SECRET_KEY=cambia-esto-por-un-valor-secreto-largo-y-aleatorio

# CORS: origenes permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# URL del frontend (para el enlace de recuperación de contraseña)
FRONTEND_URL=http://localhost:3000

# Logging SQL
SQL_ECHO=false

# -------- SMTP (correo real: verificación de cuenta, recuperación y avisos) --------
# Gmail/Workspace: activa la verificación en dos pasos y crea una
# "Contraseña de aplicación" (https://myaccount.google.com/apppasswords).
# Son 16 letras; se pega SIN espacios (también se acepta con espacios).
# OBLIGATORIO para que lleguen los correos de verificación y recuperación.
EMAIL_USER=
EMAIL_PASSWORD=
MAIL_FROM=
# Nombre visible en la bandeja (mejor entrega que solo la dirección).
MAIL_FROM_NAME=Multi-Administrador
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# Cifrado del SMTP. Déjalos VACÍOS para que se deduzcan del puerto:
#   MAIL_PORT=587 -> STARTTLS=true,  SSL_TLS=false
#   MAIL_PORT=465 -> STARTTLS=false, SSL_TLS=true
MAIL_STARTTLS=
MAIL_SSL_TLS=
# Autenticación. Pon false solo con un buzón local de pruebas (Mailpit/MailHog).
MAIL_AUTH=true
# Validación del certificado TLS (no lo desactives en producción).
MAIL_SSL_CERTS=true
# Segundos de espera por operación SMTP.
MAIL_TIMEOUT=30

# Otros proveedores (ejemplos):
#   Outlook/Hotmail : MAIL_SERVER=smtp-mail.outlook.com   MAIL_PORT=587
#   Resend          : MAIL_SERVER=smtp.resend.com         MAIL_PORT=587  (EMAIL_USER=resend, EMAIL_PASSWORD=re_...)
#   Brevo           : MAIL_SERVER=smtp-relay.brevo.com    MAIL_PORT=587
#   Buzón local     : MAIL_SERVER=127.0.0.1  MAIL_PORT=1025  MAIL_AUTH=false  (Mailpit / MailHog)

# -------- Registro de administradores (modo demo) --------
# true = el formulario "Crear cuenta" puede elegir Administrador.
# false = bloqueado (recomendado en producción).
PERMITIR_REGISTRO_ADMIN=true

# -------- Redis --------
REDIS_URL=redis://localhost:6379/0

# -------- Chatbot (Ollama - última versión) --------
# ollama = IA local con Ollama (https://ollama.com). En desarrollo local apunta a localhost:11434.
# local  = motor por reglas con datos de la BD (respaldo automático si Ollama no responde).
CHATBOT_ENGINE=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=10m

# --- Notificaciones reales: Web Push (VAPID) ---
# Genera tus propias claves con:  python backend/generar_vapid.py --guardar
# La PRIVADA va SOLO en .env (gitignored). Aquí deja los marcadores.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@gmail.com
# Interruptor de emergencia para los correos de notificaciones (true/false).
NOTIFICACIONES_CORREO=true
