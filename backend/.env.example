# Datos de conexión a PostgreSQL (en Docker se usan los del compose)
DATABASE_URL=postgresql://multiadmin:multiadmin@localhost:5432/multiadmin_db

# Clave secreta para firmar los JWT
SECRET_KEY=cambia-esto-por-un-valor-secreto-largo-y-aleatorio

# CORS: origenes permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# URL del frontend (para el enlace de recuperación de contraseña)
FRONTEND_URL=http://localhost:3000

# Logging SQL
SQL_ECHO=false

# -------- SMTP (correo real: verificación de cuenta y recuperación de contraseña) --------
# Gmail: activa la verificación en dos pasos y crea una "Contraseña de aplicación"
# (https://myaccount.google.com/apppasswords). Son 16 letras; se pega SIN espacios.
# OBLIGATORIO para registro con verificación y recuperación de contraseña (sin esto NO se envían correos).
EMAIL_USER=
EMAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# -------- Redis --------
REDIS_URL=redis://localhost:6379/0

# -------- Chatbot --------
# Si se deja vacío, el chatbot usa el motor local (base de datos + reglas).
# Si se llena con una API de OpenAI, el chatbot usa LLM + RAG.
CHATBOT_ENGINE=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
