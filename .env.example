# ==== Multi-Administrador - Variables de entorno (Docker Compose) ====
# PostgreSQL
POSTGRES_USER=multiadmin
POSTGRES_PASSWORD=multiadmin
POSTGRES_DB=multiadmin_db

# Clave secreta para firmar JWT (cámbiala en producción)
SECRET_KEY=cambia-esto-por-un-valor-secreto-largo-y-aleatorio

# Orígenes permitidos (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# URL del frontend (se usa en el enlace de recuperación de contraseña)
FRONTEND_URL=http://localhost:3000

# URL de la API que consume el frontend (build arg)
VITE_API_URL=http://localhost:8000

# ---- SMTP (OBLIGATORIO: verificación de cuenta y recuperación de contraseña) ----
# Gmail: activa verificación en 2 pasos y crea una "Contraseña de aplicación"
# (https://myaccount.google.com/apppasswords). 16 letras, pegar SIN espacios.
EMAIL_USER=tu@gmail.com
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=tu@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# ---- Chatbot (Ollama - última versión) ----
# ollama = IA local con Ollama (última versión, sin API de pago; descarga automática en Docker).
# local  = motor por reglas con datos de la BD (respaldo offline).
CHATBOT_ENGINE=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_PORT=11434
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=10m

# ---- Notificaciones Web Push (VAPID) — UH-01 / UH-18 ----
# Genera tus propias claves con: python backend/generar_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@gmail.com

# Logging SQL
SQL_ECHO=false
