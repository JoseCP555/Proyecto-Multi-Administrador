# ==== Multi-Administrador - Variables de entorno (Docker Compose) ====

# PostgreSQL
POSTGRES_USER=multiadmin
POSTGRES_PASSWORD=multiadmin
POSTGRES_DB=multiadmin_db

# Clave secreta para firmar JWT (cámbiala en producción)
SECRET_KEY=cambia-esto-por-un-valor-secreto-largo-y-aleatorio

# Orígenes permitidos (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# URL del frontend (se usa en el enlace de recuperación de contraseña)
FRONTEND_URL=http://localhost:3000

# URL de la API que consume el frontend (build arg)
VITE_API_URL=http://localhost:8000

# ---- SMTP (OBLIGATORIO: verificación de cuenta y recuperación de contraseña) ----
# Gmail: activa verificación en 2 pasos y crea una "Contraseña de aplicación"
# (https://myaccount.google.com/apppasswords). 16 letras, pegar SIN espacios.
EMAIL_USER=tu@gmail.com
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=tu@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# ---- Chatbot ----
# local = motor con datos de la BD (sin API externa). llm = modelo OpenAI (requiere API key).
CHATBOT_ENGINE=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Logging SQL
SQL_ECHO=false
