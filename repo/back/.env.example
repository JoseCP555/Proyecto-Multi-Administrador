DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_bd
SECRET_KEY=cambia-esto-por-un-valor-secreto-largo-y-aleatorio

# CORS: origenes permitidos del frontend, separados por coma
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging de SQL (dejar en false en produccion)
SQL_ECHO=false

# URL del frontend usada para armar el link de recuperacion de password
FRONTEND_URL=http://localhost:5173

# Correo (deben coincidir con lo que lee back/email_config.py)
EMAIL_USER=
EMAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=
